        "description": "Create a new booking for the signed-in business. Times use 24h HH:MM and dates use YYYY-MM-DD.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
