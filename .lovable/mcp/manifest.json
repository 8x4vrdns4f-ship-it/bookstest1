            "client_name": {
              "type": "string",
              "description": "Customer name."
            },
            "booking_date": {
              "type": "string",
              "description": "Booking date, YYYY-MM-DD."
            },
            "booking_time": {
              "type": "string",
              "description": "Booking start time, 24h HH:MM."
            },
            "service": {
              "type": "string",
              "description": "Service name for this booking."
